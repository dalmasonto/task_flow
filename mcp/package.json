{
  "name": "@taskflow/mcp",
  "version": "0.1.0",
  "description": "TaskFlow MCP server + Claude Code hooks — an agent client that drives the TaskFlow backend agent API using a stable .taskflow.json credential.",
  "type": "module",
  "bin": {
    "taskflow-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "hooks",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "taskflow",
    "ai-agent",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
